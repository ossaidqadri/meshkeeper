#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

PROG=/usr/sbin/multiap-ctl
STATE_DIR=/etc/multiap-ctl

start_service() {
	# Unprivileged account; the ubus ACL in /usr/share/acl.d grants it only the calls it makes.
	# ubusd resolves ACL user names when it loads them, so a new user needs a reload.
	user_exists multiap || {
		user_add multiap "" "$(group_add_next multiap)" multiap "$STATE_DIR"
		kill -HUP "$(pidof ubusd)"
	}
	mkdir -p "$STATE_DIR"
	chown -R multiap:multiap "$STATE_DIR"

	procd_open_instance
	procd_set_param command "$PROG"
	# Boot can race br-lan/rpcd; keep retrying instead of giving up.
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	[ -x /sbin/ujail -a -e /etc/capabilities/multiap-ctl.json ] && {
		procd_add_jail multiap-ctl ubus sysfs
		procd_add_jail_mount /bin/ubus
		procd_add_jail_mount_rw "$STATE_DIR"
		procd_set_param capabilities /etc/capabilities/multiap-ctl.json
		procd_set_param user multiap
		procd_set_param group multiap
		procd_set_param no_new_privs 1
	}
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger multiap-ctl
}
