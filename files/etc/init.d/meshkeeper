#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

PROG=/usr/sbin/meshkeeper
STATE_DIR=/etc/meshkeeper
MESH_DIR=/var/run/meshkeeper

start_service() {
	# The package creates the unprivileged meshkeeper user; the ubus ACL in
	# /usr/share/acl.d grants it only the calls it makes. ubusd resolves ACL user
	# names only when it loads them, and the user is created before this first
	# start, so reload every time; it's cheap and harmless when nothing changed.
	pidof ubusd >/dev/null && kill -HUP $(pidof ubusd)
	mkdir -p "$STATE_DIR" "$MESH_DIR"
	chown -R meshkeeper:meshkeeper "$STATE_DIR" "$MESH_DIR"

	procd_open_instance
	procd_set_param command "$PROG"
	# procd restarts the instance only when its parameters change, and a file's
	# checksum is one. The config makes `uci commit` + reload_config apply it;
	# the binary makes an apk upgrade's `start` run the new one.
	procd_set_param file /etc/config/meshkeeper "$PROG"
	# Boot can race br-lan/rpcd; keep retrying instead of giving up.
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	# requirejail: never fall back to running unjailed. ronly: the only
	# writable paths are the two mounted read-write below.
	procd_add_jail meshkeeper ubus sysfs log ronly requirejail
	# The directory, not single files: uci commit replaces files, and a
	# file mount would keep showing the old one. Root-only configs stay
	# unreadable to the service user.
	procd_add_jail_mount /etc/config
	procd_add_jail_mount_rw "$STATE_DIR" "$MESH_DIR"
	procd_set_param capabilities /etc/capabilities/meshkeeper.json
	procd_set_param user meshkeeper
	procd_set_param group meshkeeper
	procd_set_param no_new_privs 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger meshkeeper
}
