#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

PROG=/usr/sbin/meshkeeper
STATE_DIR=/etc/meshkeeper

start_service() {
	# Unprivileged account; the ubus ACL in /usr/share/acl.d grants it only the calls it makes.
	# ubusd resolves ACL user names when it loads them, so a new user needs a reload.
	user_exists meshkeeper || {
		user_add meshkeeper "" "$(group_add_next meshkeeper)" meshkeeper "$STATE_DIR"
		kill -HUP "$(pidof ubusd)"
	}
	mkdir -p "$STATE_DIR"
	chown -R meshkeeper:meshkeeper "$STATE_DIR"

	procd_open_instance
	procd_set_param command "$PROG"
	# Boot can race br-lan/rpcd; keep retrying instead of giving up.
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	[ -x /sbin/ujail -a -e /etc/capabilities/meshkeeper.json ] && {
		procd_add_jail meshkeeper ubus sysfs log
		procd_add_jail_mount /bin/ubus
		procd_add_jail_mount_rw "$STATE_DIR"
		procd_set_param capabilities /etc/capabilities/meshkeeper.json
		procd_set_param user meshkeeper
		procd_set_param group meshkeeper
		procd_set_param no_new_privs 1
	}
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger meshkeeper
}
