FROM debian:bookworm
# deb.debian.org is slow from some networks (79 KB/s against 2 MB/s for kernel.org's mirror here);
# run.sh passes BENCH_DEBIAN_MIRROR, CI keeps the default.
ARG DEBIAN_MIRROR=
RUN [ -z "$DEBIAN_MIRROR" ] || sed -i "s|http://deb.debian.org/debian$|$DEBIAN_MIRROR|" /etc/apt/sources.list.d/debian.sources
# qemu-system-mips 7.2 in bookworm: new enough for -netdev dgram.
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends qemu-system-mips qemu-system-x86 ipxe-qemu seabios curl ca-certificates openssh-client xz-utils >/dev/null
COPY --from=ghcr.io/astral-sh/uv:0.11.28 /uv /usr/local/bin/uv
# Zig builds the fake satellite from the repo's own sources. Same version and hash as the Makefile.
ARG ZIG_VERSION=0.17.0
ARG ZIG_SHA256=1cbe9df9f27e6b78d14ccbca43b6703a404ef79ef1c463de901d7f088d4e2026
RUN curl -fsSL -o /tmp/zig.tar.xz https://ziglang.org/download/${ZIG_VERSION}/zig-x86_64-linux-${ZIG_VERSION}.tar.xz \
 && echo "${ZIG_SHA256}  /tmp/zig.tar.xz" | sha256sum -c - \
 && mkdir /opt/zig && tar -xJf /tmp/zig.tar.xz -C /opt/zig --strip-components=1 \
 && ln -s /opt/zig/zig /usr/local/bin/zig
# The project lives on a host mount; keep the venv and caches off it.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy UV_CACHE_DIR=/opt/uv-cache UV_PYTHON_INSTALL_DIR=/opt/uv-python ZIG_GLOBAL_CACHE_DIR=/opt/zig-cache
# Python and the test dependencies, installed once here; `uv sync --frozen` at run time is then a no-op.
COPY pyproject.toml uv.lock /opt/bench/
RUN cd /opt/bench && uv sync --frozen --no-install-project
# The repo is mounted at /repo: the fake satellite imports ../src/cmdu.zig and wsc.zig.
WORKDIR /repo/bench
