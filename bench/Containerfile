FROM debian:bookworm
# qemu-system-mips 7.2 in bookworm: new enough for -netdev dgram.
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends qemu-system-mips ipxe-qemu seabios curl ca-certificates openssh-client >/dev/null
COPY --from=ghcr.io/astral-sh/uv:0.11.28 /uv /usr/local/bin/uv
# The project lives on a host mount; keep the venv and caches off it.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_LINK_MODE=copy UV_CACHE_DIR=/opt/uv-cache UV_PYTHON_INSTALL_DIR=/opt/uv-python
WORKDIR /bench
